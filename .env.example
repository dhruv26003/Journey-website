# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.

# -------------------------------------------------------
# Django Secret Key
# Generate a new one for production using:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# -------------------------------------------------------
SECRET_KEY=django-insecure-change-me-in-production

# -------------------------------------------------------
# Debug Mode
# Set to False in production to disable the debug toolbar
# and prevent sensitive error details from being shown.
# -------------------------------------------------------
DEBUG=True

# -------------------------------------------------------
# Allowed Hosts
# Comma-separated list of hostnames/IPs Django will serve.
# Example for production: example.com,www.example.com
# -------------------------------------------------------
ALLOWED_HOSTS=127.0.0.1,localhost

# -------------------------------------------------------
# Database URL
# Leave blank (or omit) to use the default SQLite database.
# SQLite (default for local dev):
#   DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production):
#   DATABASE_URL=postgres://user:password@host:5432/dbname
# -------------------------------------------------------
DATABASE_URL=

# -------------------------------------------------------
# Media Root (optional)
# Absolute filesystem path where user-uploaded files are stored.
# Defaults to a "media/" directory inside the project root.
# Example: MEDIA_ROOT=/var/www/mysite/media
# -------------------------------------------------------
# MEDIA_ROOT=

# -------------------------------------------------------
# Static Root (optional)
# Absolute filesystem path where collectstatic places files.
# Defaults to a "staticfiles/" directory inside the project root.
# Only required when DEBUG=False (production).
# Example: STATIC_ROOT=/var/www/mysite/staticfiles
# -------------------------------------------------------
# STATIC_ROOT=
